datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  MANAGER
  ADMIN
}

enum RequestStatus {
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  RESOLVED
  REJECTED
  CANCELLED
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequestCategory {
  EQUIPMENT
  IT_SUPPORT
  FACILITY
  EXPENSE
  GENERAL
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(USER)
  department    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  
  requestedRequests Request[]         @relation("Requester")
  assignedRequests  Request[]         @relation("Assignee")
  activities        RequestActivity[]
  comments          RequestComment[]

  @@index([role])
  @@index([department])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Request {
  id            String          @id @default(cuid())
  requestNumber String          @unique
  title         String
  description   String          @db.Text
  category      RequestCategory @default(GENERAL)
  priority      RequestPriority @default(MEDIUM)
  status        RequestStatus   @default(PENDING_APPROVAL)
  department    String
  budget        Float?

  requesterId   String
  requester     User            @relation("Requester", fields: [requesterId], references: [id], onDelete: Restrict)

  assigneeId    String?
  assignee      User?           @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  activities    RequestActivity[]
  comments      RequestComment[]
  attachments   Attachment[]

  @@index([requesterId])
  @@index([assigneeId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
}

model RequestActivity {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([actorId])
}

model RequestComment {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([userId])
}

model Attachment {
  id         String   @id @default(cuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String   @db.Text
  fileSize   Int?
  fileType   String?
  uploadedAt DateTime @default(now())

  @@index([requestId])
}
